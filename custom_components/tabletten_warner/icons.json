{
  "entity": {
    "binary_sensor": {
      "due": {
        "default": "mdi:pill-off",
        "state": {
          "on": "mdi:pill"
        }
      },
      "any_due": {
        "default": "mdi:bell-check",
        "state": {
          "on": "mdi:bell-ring"
        }
      }
    },
    "button": {
      "taken": {
        "default": "mdi:check-circle"
      },
      "snooze": {
        "default": "mdi:alarm-snooze"
      },
      "skip": {
        "default": "mdi:skip-next-circle"
      },
      "delete_medication": {
        "default": "mdi:delete"
      },
      "add_medication": {
        "default": "mdi:plus-circle"
      }
    },
    "calendar": {
      "doses": {
        "default": "mdi:calendar-check"
      }
    },
    "sensor": {
      "status": {
        "default": "mdi:pill",
        "state": {
          "scheduled": "mdi:clock-outline",
          "due": "mdi:bell-ring",
          "snoozed": "mdi:alarm-snooze",
          "taken": "mdi:check-circle",
          "missed": "mdi:close-circle",
          "skipped": "mdi:skip-next-circle",
          "paused": "mdi:pause-circle"
        }
      },
      "next_dose": {
        "default": "mdi:clock-start"
      },
      "last_taken": {
        "default": "mdi:history"
      },
      "adherence_7d": {
        "default": "mdi:chart-arc"
      },
      "adherence_30d": {
        "default": "mdi:chart-arc"
      },
      "streak": {
        "default": "mdi:fire"
      },
      "open_today": {
        "default": "mdi:pill-multiple"
      },
      "taken_today": {
        "default": "mdi:check-all"
      },
      "missed_today": {
        "default": "mdi:close-octagon"
      },
      "skipped_today": {
        "default": "mdi:skip-next"
      }
    },
    "switch": {
      "reminders": {
        "default": "mdi:bell",
        "state": {
          "off": "mdi:bell-off"
        }
      }
    },
    "text": {
      "cfg_name": {
        "default": "mdi:pill"
      },
      "cfg_times": {
        "default": "mdi:clock-outline"
      },
      "cfg_dosage": {
        "default": "mdi:scale-balance"
      },
      "cfg_weekdays": {
        "default": "mdi:calendar-week"
      },
      "new_name": {
        "default": "mdi:pill"
      },
      "new_times": {
        "default": "mdi:clock-plus-outline"
      },
      "new_dosage": {
        "default": "mdi:scale-balance"
      }
    },
    "number": {
      "cfg_early_minutes": {
        "default": "mdi:clock-start"
      },
      "cfg_late_minutes": {
        "default": "mdi:clock-end"
      }
    }
  },
  "services": {
    "mark_taken": {
      "service": "mdi:check-circle"
    },
    "snooze": {
      "service": "mdi:alarm-snooze"
    },
    "skip": {
      "service": "mdi:skip-next-circle"
    },
    "get_history": {
      "service": "mdi:history"
    },
    "export_history": {
      "service": "mdi:file-delimited"
    }
  }
}
